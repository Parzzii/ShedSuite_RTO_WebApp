# Firebird ODBC DSN used by the original Excel Power Queries.
RTO_DSN=Firebird DSN

# Optional. Leave blank when credentials are already stored in the DSN.
RTO_DB_USER=
RTO_DB_PASSWORD=

# Optional ZipTax override.
ZIPTAX_API_KEY=

# RTO Pro executable / staging.
RTO_EXE=C:\RTOwin\RTO-win.exe
RTO_IMPORT_STAGING=
ENABLE_RTO_LAUNCH=true

# RTO document imaging.
RTO_IMAGES_ROOT=\\evg-s01\Company Data\RTO Pro\Evergreen\Images
RTO_TEST_IMAGES_ROOT=C:\RTO Pro\TestDB\Images

# V7.25 encrypted ShedSuite/company vault.
# Leave blank for the cross-platform default: ~/.shedsuite_rto/company_vault.enc
SHEDSUITE_VAULT_FILE=
# OPTIONAL one-time migration only. Normal V7.25 Delivery Certificate downloads
# never read Contract_Import.xlsm. Set this only if you want the Company Manager
# "Import legacy logins once" button to target a specific old workbook.
LEGACY_XLSM_PATH=

# Number of different ShedSuite login/accounts that may prefetch in parallel.
# V7.25 never cycles through unrelated accounts; this only affects distinct
# correctly mapped companies in the same batch. Keep between 1 and 5.
CERT_PREFETCH_CONCURRENCY=3

# Local Flask session secret; change if desired.
FLASK_SECRET_KEY=change-this-local-secret

# Optional cross-version correction-learning file override.
SHEDSUITE_LEARNING_FILE=
