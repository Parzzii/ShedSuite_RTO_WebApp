# Firebird ODBC DSN used by the original Excel Power Queries.
RTO_DSN=Firebird DSN

# Optional. Leave blank when credentials are already stored in the Windows DSN.
RTO_DB_USER=
RTO_DB_PASSWORD=

# Optional ZipTax override. V6 preserves V3's transform/tax behavior.
ZIPTAX_API_KEY=

# V5.3 RTO Pro upload capability transplanted into V3.
RTO_EXE=C:\RTOwin\RTO-win.exe
# Leave blank: V6 tries RTOwin\app.csv, then LocalAppData, TEMP, then the job folder.
RTO_IMPORT_STAGING=
ENABLE_RTO_LAUNCH=true

# RTO document imaging (same V3 workflow after the customer import succeeds).
RTO_IMAGES_ROOT=\\evg-s01\Company Data\RTO Pro\Evergreen\Images
RTO_TEST_IMAGES_ROOT=C:\RTO Pro\TestDB\Images

# Delivery Certificate capability. Credentials come from the old Logininfo table.
# Usually auto-detected if Contract_Import.xlsm is beside the app or in Downloads/Desktop/Documents.
LEGACY_XLSM_PATH=

# V7.21 optional: cross-version Company -> ShedSuite login mappings.
# Leave blank to use %LOCALAPPDATA%\ShedSuiteRTO\shedsuite_login_mappings.json on Windows.
SHEDSUITE_LOGIN_MAPPING_FILE=

# V7.15: number of different ShedSuite login/accounts that may prefetch in parallel.
# Keep between 1 and 5. 3 is a safe default.
CERT_PREFETCH_CONCURRENCY=3

# Local Flask session secret; change if desired.
FLASK_SECRET_KEY=change-this-local-secret

# V7.16 optional: override the cross-version correction-learning file location.
# Leave blank to use %LOCALAPPDATA%\ShedSuiteRTO\learned_corrections.json on Windows.
SHEDSUITE_LEARNING_FILE=
